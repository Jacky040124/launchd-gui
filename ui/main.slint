import { Button, HorizontalBox, LineEdit, ListView, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    in-out property <[string]> job_lines: [];
    in-out property <string> status_message: "";
    in-out property <bool> busy: false;
    in-out property <bool> confirm_delete_visible: false;
    in-out property <string> confirm_delete_label: "";
    in-out property <string> query_text: "";
    in-out property <string> command_query: "";
    in-out property <string> active_filter_text: "all scopes";
    in-out property <string> status_filter_text: "Status:any";
    in-out property <string> disabled_filter_text: "Disabled:any";
    in-out property <string> run_at_load_filter_text: "RunAtLoad:any";
    in-out property <string> keep_alive_filter_text: "KeepAlive:any";
    in-out property <string> error_filter_text: "HasError:any";
    in-out property <string> detail_label: "";
    in-out property <string> detail_scope: "";
    in-out property <string> detail_status: "";
    in-out property <string> detail_path: "";
    in-out property <string> detail_run_at_load: "";
    in-out property <string> detail_keep_alive: "";
    in-out property <string> detail_disabled_key: "";
    in-out property <string> detail_pid: "";
    in-out property <string> detail_last_exit: "";
    in-out property <string> detail_last_run: "";
    in-out property <string> detail_runtime_hint: "";
    in-out property <string> detail_error: "";
    in-out property <bool> is_starred: false;
    in-out property <bool> advanced_detail_visible: false;
    in-out property <bool> show_starred_only: false;
    in-out property <int> selected_job_row: -1;
    in-out property <bool> can_trigger: false;
    in-out property <bool> can_delete: false;
    in-out property <string> editor_target_text: "";
    in-out property <string> editor_label: "";
    in-out property <string> editor_program: "";
    in-out property <string> editor_program_arguments: "";
    in-out property <string> editor_working_directory: "";
    in-out property <string> editor_start_interval: "";
    in-out property <string> editor_env_vars: "";
    in-out property <string> editor_expert_entries: "";
    in-out property <bool> editor_run_at_load: false;
    in-out property <bool> editor_keep_alive: false;
    in-out property <string> editor_xml_preview: "";
    in-out property <string> editor_diagnostics_text: "";
    in-out property <string> log_view_text: "";
    in-out property <string> ai_prompt: "";
    in-out property <string> ai_response: "";
    in-out property <string> ai_provider_text: "AI Provider: heuristic-local";
    in-out property <string> key_panel_query: "";
    in-out property <string> key_panel_count_text: "";
    in-out property <[string]> key_panel_lines: [];

    callback refresh_requested();
    callback select_job(int);
    callback trigger_requested(string);
    callback delete_requested();
    callback confirm_delete();
    callback cancel_delete();
    callback query_changed(string);
    callback command_query_changed(string);
    callback command_requested();
    callback scope_filter_requested(string);
    callback status_filter_requested(string);
    callback cycle_disabled_filter_requested();
    callback cycle_run_at_load_filter_requested();
    callback cycle_keep_alive_filter_requested();
    callback cycle_error_filter_requested();
    callback clear_filters_requested();
    callback toggle_star_requested();
    callback copy_detail_requested();
    callback toggle_advanced_requested();
    callback star_filter_toggled(bool);
    callback editor_label_changed(string);
    callback editor_program_changed(string);
    callback editor_args_changed(string);
    callback editor_working_dir_changed(string);
    callback editor_start_interval_changed(string);
    callback editor_env_changed(string);
    callback editor_expert_entries_changed(string);
    callback toggle_editor_run_at_load();
    callback toggle_editor_keep_alive();
    callback save_editor_requested();
    callback new_job_requested(string);
    callback refresh_logs_requested();
    callback ai_prompt_changed(string);
    callback ai_request_requested();
    callback ai_cycle_provider_requested();
    callback key_panel_query_changed(string);
    callback key_panel_add_requested(int);

    title: "LaunchPad";
    width: 1120px;
    height: 920px;
    background: #f5f7fb;

    VerticalBox {
        spacing: 12px;
        padding: 14px;

        HorizontalBox {
            spacing: 10px;
            Button {
                text: "Refresh";
                enabled: !root.busy;
                clicked => { root.refresh_requested(); }
            }
            LineEdit {
                width: 380px;
                enabled: !root.busy;
                text <=> root.command_query;
                placeholder-text: "Command palette: refresh / enable / new user / save / logs";
                edited(value) => { root.command_query_changed(value); }
            }
            Button {
                text: "Run Command";
                enabled: !root.busy;
                clicked => { root.command_requested(); }
            }
            Text {
                text: root.busy ? "LaunchPad · refreshing jobs..." : "LaunchPad · launchd control center";
                vertical-alignment: center;
                font-size: 15px;
                color: #182230;
            }
        }

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                width: 300px;
                enabled: !root.busy;
                text <=> root.query_text;
                placeholder-text: "Search label or path";
                edited(text) => { root.query_changed(text); }
            }
            Button {
                text: root.show_starred_only ? "★ Starred only" : "☆ Starred only";
                enabled: !root.busy;
                clicked => { root.star_filter_toggled(!root.show_starred_only); }
            }
            Button {
                text: "All";
                enabled: !root.busy;
                clicked => { root.clear_filters_requested(); }
            }
            Button {
                text: "User Agents";
                enabled: !root.busy;
                clicked => { root.scope_filter_requested("user-agent"); }
            }
            Button {
                text: "Global Agents";
                enabled: !root.busy;
                clicked => { root.scope_filter_requested("global-agent"); }
            }
            Button {
                text: "Daemons";
                enabled: !root.busy;
                clicked => { root.scope_filter_requested("system-daemon"); }
            }
            Text {
                text: "Filter: " + root.active_filter_text;
                vertical-alignment: center;
                color: #475467;
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button {
                text: root.status_filter_text;
                enabled: !root.busy;
                clicked => { root.status_filter_requested("any"); }
            }
            Button {
                text: "Running";
                enabled: !root.busy;
                clicked => { root.status_filter_requested("running"); }
            }
            Button {
                text: "Loaded";
                enabled: !root.busy;
                clicked => { root.status_filter_requested("loaded"); }
            }
            Button {
                text: "Disabled";
                enabled: !root.busy;
                clicked => { root.status_filter_requested("disabled"); }
            }
            Button {
                text: "Unknown";
                enabled: !root.busy;
                clicked => { root.status_filter_requested("unknown"); }
            }
            Button {
                text: root.disabled_filter_text;
                enabled: !root.busy;
                clicked => { root.cycle_disabled_filter_requested(); }
            }
            Button {
                text: root.run_at_load_filter_text;
                enabled: !root.busy;
                clicked => { root.cycle_run_at_load_filter_requested(); }
            }
            Button {
                text: root.keep_alive_filter_text;
                enabled: !root.busy;
                clicked => { root.cycle_keep_alive_filter_requested(); }
            }
            Button {
                text: root.error_filter_text;
                enabled: !root.busy;
                clicked => { root.cycle_error_filter_requested(); }
            }
        }

        HorizontalBox {
            spacing: 12px;

            Rectangle {
                border-width: 1px;
                border-color: #d0d5dd;
                border-radius: 10px;
                background: #ffffff;
                horizontal-stretch: 0.9;
                clip: true;

                VerticalBox {
                    padding: 8px;
                    spacing: 8px;

                    Text {
                        text: "Jobs";
                        font-weight: 700;
                        color: #182230;
                    }

                    Rectangle {
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #eaecf0;
                        clip: true;
                        vertical-stretch: 1;

                        ListView {
                            for line[index] in root.job_lines : Rectangle {
                                height: 40px;
                                border-radius: 6px;
                                x: 4px;
                                width: parent.width - 8px;
                                background: root.selected_job_row == index ? #e0ebff : #ffffff;
                                animate background { duration: 160ms; easing: ease-in-out; }

                                Text {
                                    text: line;
                                    x: 10px;
                                    y: (parent.height - self.height) / 2;
                                    color: root.selected_job_row == index ? #12326b : #344054;
                                    font-weight: root.selected_job_row == index ? 600 : 400;
                                }

                                TouchArea {
                                    clicked => { root.select_job(index); }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                border-width: 1px;
                border-color: #d0d5dd;
                border-radius: 10px;
                background: #ffffff;
                horizontal-stretch: 1.1;

                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: "Selected Job";
                        font-weight: 700;
                        color: #182230;
                    }

                    Rectangle {
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #eaecf0;
                        background: #f8faff;
                        VerticalBox {
                            padding: 10px;
                            spacing: 4px;
                            Text { text: "Label: " + root.detail_label; color: #101828; }
                            Text { text: "Scope: " + root.detail_scope; color: #344054; }
                            Text { text: "Status: " + root.detail_status; color: #344054; }
                            Text { text: "Path: " + root.detail_path; color: #344054; wrap: word-wrap; }
                            Text { text: "RunAtLoad: " + root.detail_run_at_load; color: #344054; }
                            Text { text: "KeepAlive: " + root.detail_keep_alive; color: #344054; }
                            Text { text: "Disabled key: " + root.detail_disabled_key; color: #344054; }
                            Text { text: root.detail_error; color: #b42318; wrap: word-wrap; }
                        }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        Button {
                            text: root.is_starred ? "Unstar" : "Star";
                            enabled: !root.busy;
                            clicked => { root.toggle_star_requested(); }
                        }
                        Button {
                            text: "Copy Details";
                            enabled: !root.busy;
                            clicked => { root.copy_detail_requested(); }
                        }
                        Button {
                            text: root.advanced_detail_visible ? "Hide Advanced" : "Show Advanced";
                            enabled: !root.busy;
                            clicked => { root.toggle_advanced_requested(); }
                        }
                    }

                    Rectangle {
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #eaecf0;
                        background: #fcfcfd;
                        clip: true;
                        height: root.advanced_detail_visible ? 116px : 0px;
                        opacity: root.advanced_detail_visible ? 1 : 0;
                        animate height, opacity { duration: 180ms; easing: ease-in-out; }

                        VerticalBox {
                            padding: 10px;
                            spacing: 4px;
                            Text { text: "PID: " + root.detail_pid; color: #344054; }
                            Text { text: "Last Exit: " + root.detail_last_exit; color: #344054; }
                            Text { text: "Last Run: " + root.detail_last_run; color: #344054; }
                            Text { text: root.detail_runtime_hint; color: #475467; wrap: word-wrap; }
                        }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button {
                text: "Start";
                enabled: root.can_trigger && !root.busy;
                clicked => { root.trigger_requested("start"); }
            }
            Button {
                text: "Stop";
                enabled: root.can_trigger && !root.busy;
                clicked => { root.trigger_requested("stop"); }
            }
            Button {
                text: "Kickstart";
                enabled: root.can_trigger && !root.busy;
                clicked => { root.trigger_requested("kickstart"); }
            }
            Button {
                text: "Enable";
                enabled: root.can_trigger && !root.busy;
                clicked => { root.trigger_requested("enable"); }
            }
            Button {
                text: "Disable";
                enabled: root.can_trigger && !root.busy;
                clicked => { root.trigger_requested("disable"); }
            }
            Button {
                text: "Load";
                enabled: root.can_trigger && !root.busy;
                clicked => { root.trigger_requested("load"); }
            }
            Button {
                text: "Unload";
                enabled: root.can_trigger && !root.busy;
                clicked => { root.trigger_requested("unload"); }
            }
            Button {
                text: "Delete";
                enabled: root.can_delete && !root.busy;
                clicked => { root.delete_requested(); }
            }
        }

        Rectangle {
            border-width: 1px;
            border-color: #d0d5dd;
            border-radius: 10px;
            background: #ffffff;
            clip: true;

            VerticalBox {
                padding: 10px;
                spacing: 8px;

                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: "Plist Editor (Standard + XML)";
                        font-weight: 700;
                        color: #182230;
                    }
                    Text {
                        text: root.editor_target_text;
                        color: #475467;
                    }
                    Button {
                        text: "New User Job";
                        enabled: !root.busy;
                        clicked => { root.new_job_requested("user-agent"); }
                    }
                    Button {
                        text: "New Global Job";
                        enabled: !root.busy;
                        clicked => { root.new_job_requested("global-agent"); }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    LineEdit {
                        width: 220px;
                        enabled: !root.busy;
                        text <=> root.editor_label;
                        placeholder-text: "Label";
                        edited(value) => { root.editor_label_changed(value); }
                    }
                    LineEdit {
                        width: 220px;
                        enabled: !root.busy;
                        text <=> root.editor_program;
                        placeholder-text: "Program path";
                        edited(value) => { root.editor_program_changed(value); }
                    }
                    LineEdit {
                        width: 240px;
                        enabled: !root.busy;
                        text <=> root.editor_program_arguments;
                        placeholder-text: "ProgramArguments (space separated)";
                        edited(value) => { root.editor_args_changed(value); }
                    }
                    LineEdit {
                        width: 200px;
                        enabled: !root.busy;
                        text <=> root.editor_working_directory;
                        placeholder-text: "WorkingDirectory";
                        edited(value) => { root.editor_working_dir_changed(value); }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    LineEdit {
                        width: 220px;
                        enabled: !root.busy;
                        text <=> root.editor_start_interval;
                        placeholder-text: "StartInterval (seconds)";
                        edited(value) => { root.editor_start_interval_changed(value); }
                    }
                    LineEdit {
                        width: 460px;
                        enabled: !root.busy;
                        text <=> root.editor_env_vars;
                        placeholder-text: "EnvironmentVariables: KEY=VALUE, KEY2=VALUE2";
                        edited(value) => { root.editor_env_changed(value); }
                    }
                    Button {
                        text: root.editor_run_at_load ? "RunAtLoad:yes" : "RunAtLoad:no";
                        enabled: !root.busy;
                        clicked => { root.toggle_editor_run_at_load(); }
                    }
                    Button {
                        text: root.editor_keep_alive ? "KeepAlive:yes" : "KeepAlive:no";
                        enabled: !root.busy;
                        clicked => { root.toggle_editor_keep_alive(); }
                    }
                    Button {
                        text: "Save";
                        enabled: !root.busy;
                        clicked => { root.save_editor_requested(); }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    LineEdit {
                        width: 980px;
                        enabled: !root.busy;
                        text <=> root.editor_expert_entries;
                        placeholder-text: "Expert keys: KEY=VALUE, KEY2=VALUE2 (for undocumented or advanced launchd keys)";
                        edited(value) => { root.editor_expert_entries_changed(value); }
                    }
                }

                Rectangle {
                    border-width: 1px;
                    border-color: #eaecf0;
                    border-radius: 8px;
                    background: #fcfcfd;
                    VerticalBox {
                        padding: 8px;
                        Text {
                            text: root.editor_xml_preview;
                            wrap: word-wrap;
                            color: #344054;
                        }
                    }
                }

                Rectangle {
                    border-width: 1px;
                    border-color: #fec84b;
                    border-radius: 8px;
                    background: #fffaeb;
                    VerticalBox {
                        padding: 8px;
                        Text {
                            text: "Diagnostics";
                            color: #7a2e0e;
                            font-weight: 600;
                        }
                        Text {
                            text: root.editor_diagnostics_text;
                            wrap: word-wrap;
                            color: #7a2e0e;
                        }
                    }
                }

                Rectangle {
                    border-width: 1px;
                    border-color: #d0d5dd;
                    border-radius: 8px;
                    background: #f8f9fc;
                    VerticalBox {
                        padding: 8px;
                        spacing: 6px;
                        HorizontalBox {
                            spacing: 8px;
                            Text {
                                text: "Logs";
                                color: #1d2939;
                                font-weight: 600;
                            }
                            Button {
                                text: "Refresh Logs";
                                enabled: !root.busy;
                                clicked => { root.refresh_logs_requested(); }
                            }
                        }
                        Text {
                            text: root.log_view_text;
                            wrap: word-wrap;
                            color: #344054;
                        }
                    }
                }

                Rectangle {
                    border-width: 1px;
                    border-color: #b2ddff;
                    border-radius: 8px;
                    background: #f5faff;
                    VerticalBox {
                        padding: 8px;
                        spacing: 6px;
                        HorizontalBox {
                            spacing: 8px;
                            LineEdit {
                                width: 720px;
                                enabled: !root.busy;
                                text <=> root.ai_prompt;
                                placeholder-text: "Ask AI to modify this launchd job...";
                                edited(value) => { root.ai_prompt_changed(value); }
                            }
                            Button {
                                text: root.ai_provider_text;
                                enabled: !root.busy;
                                clicked => { root.ai_cycle_provider_requested(); }
                            }
                            Button {
                                text: "AI Analyze";
                                enabled: !root.busy;
                                clicked => { root.ai_request_requested(); }
                            }
                        }
                        Text {
                            text: root.ai_response;
                            wrap: word-wrap;
                            color: #175cd3;
                        }
                    }
                }

                Rectangle {
                    border-width: 1px;
                    border-color: #d0d5dd;
                    border-radius: 8px;
                    background: #ffffff;
                    VerticalBox {
                        padding: 8px;
                        spacing: 6px;
                        HorizontalBox {
                            spacing: 8px;
                            LineEdit {
                                width: 320px;
                                enabled: !root.busy;
                                text <=> root.key_panel_query;
                                placeholder-text: "Search launchd keys...";
                                edited(value) => { root.key_panel_query_changed(value); }
                            }
                            Text {
                                text: "Key Panel · " + root.key_panel_count_text;
                                vertical-alignment: center;
                                color: #475467;
                            }
                        }
                        Rectangle {
                            border-width: 1px;
                            border-color: #eaecf0;
                            border-radius: 8px;
                            background: #fcfcfd;
                            clip: true;
                            height: 170px;
                            ListView {
                                for line[index] in root.key_panel_lines : Rectangle {
                                    height: 34px;
                                    background: #ffffff;
                                    Text {
                                        text: line;
                                        x: 8px;
                                        y: (parent.height - self.height) / 2;
                                        color: #344054;
                                    }
                                    TouchArea {
                                        clicked => { root.key_panel_add_requested(index); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            visible: root.confirm_delete_visible;
            border-width: 1px;
            border-color: #fecdca;
            border-radius: 8px;
            background: #fffbfa;
            opacity: root.confirm_delete_visible ? 1 : 0;
            animate opacity { duration: 140ms; easing: ease-in-out; }

            VerticalBox {
                padding: 10px;
                spacing: 6px;
                Text {
                    text: "Delete '" + root.confirm_delete_label + "' ?";
                    color: #b42318;
                    font-weight: 600;
                }
                Text {
                    text: "This action is irreversible. The plist file will be removed.";
                    wrap: word-wrap;
                }
                HorizontalBox {
                    spacing: 8px;
                    Button {
                        text: "Confirm Delete";
                        enabled: !root.busy;
                        clicked => { root.confirm_delete(); }
                    }
                    Button {
                        text: "Cancel";
                        enabled: !root.busy;
                        clicked => { root.cancel_delete(); }
                    }
                }
            }
        }

        Rectangle {
            border-width: 1px;
            border-color: #ececec;
            border-radius: 8px;
            background: #ffffff;
            VerticalBox {
                padding: 8px;
                Text {
                    text: root.busy ? "Working..." : root.status_message;
                    wrap: word-wrap;
                    color: root.busy ? #175cd3 : #344054;
                }
            }
        }
    }
}
