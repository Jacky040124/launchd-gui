import { Button, HorizontalBox, LineEdit, ListView, VerticalBox } from "std-widgets.slint";
import { RaycastTheme } from "theme/raycast_tokens.slint";
import { TopCommandBar } from "components/top_command_bar.slint";
import { SearchScopeBar } from "components/search_scope_bar.slint";
import { StatusFilterBar } from "components/status_filter_bar.slint";
import { JobsWorkspace } from "components/jobs_workspace.slint";
import { ActionBar } from "components/action_bar.slint";

export component MainWindow inherits Window {
    in-out property <[string]> job_lines: [];
    in-out property <string> status_message: "";
    in-out property <bool> busy: false;
    in-out property <bool> confirm_delete_visible: false;
    in-out property <string> confirm_delete_label: "";
    in-out property <string> query_text: "";
    in-out property <string> command_query: "";
    in-out property <string> active_filter_text: "all scopes";
    in-out property <string> status_filter_text: "Status:any";
    in-out property <string> disabled_filter_text: "Disabled:any";
    in-out property <string> run_at_load_filter_text: "RunAtLoad:any";
    in-out property <string> keep_alive_filter_text: "KeepAlive:any";
    in-out property <string> error_filter_text: "HasError:any";
    in-out property <string> detail_label: "";
    in-out property <string> detail_scope: "";
    in-out property <string> detail_status: "";
    in-out property <string> detail_path: "";
    in-out property <string> detail_run_at_load: "";
    in-out property <string> detail_keep_alive: "";
    in-out property <string> detail_disabled_key: "";
    in-out property <string> detail_pid: "";
    in-out property <string> detail_last_exit: "";
    in-out property <string> detail_last_run: "";
    in-out property <string> detail_runtime_hint: "";
    in-out property <string> detail_error: "";
    in-out property <bool> is_starred: false;
    in-out property <bool> advanced_detail_visible: false;
    in-out property <bool> show_starred_only: false;
    in-out property <int> selected_job_row: -1;
    in-out property <bool> can_trigger: false;
    in-out property <bool> can_delete: false;
    in-out property <string> editor_target_text: "";
    in-out property <string> editor_label: "";
    in-out property <string> editor_program: "";
    in-out property <string> editor_program_arguments: "";
    in-out property <string> editor_working_directory: "";
    in-out property <string> editor_start_interval: "";
    in-out property <string> editor_env_vars: "";
    in-out property <string> editor_expert_entries: "";
    in-out property <bool> editor_run_at_load: false;
    in-out property <bool> editor_keep_alive: false;
    in-out property <string> editor_xml_preview: "";
    in-out property <string> editor_diagnostics_text: "";
    in-out property <string> log_view_text: "";
    in-out property <bool> log_live_mode: false;
    in-out property <string> log_mode_text: "Mode:History";
    in-out property <string> log_window_minutes: "10";
    in-out property <string> log_stream_seconds: "5";
    in-out property <string> log_max_lines: "120";
    in-out property <string> ai_prompt: "";
    in-out property <string> ai_response: "";
    in-out property <string> ai_provider_text: "AI Provider: heuristic-local";
    in-out property <string> ai_diff_preview: "";
    in-out property <bool> ai_patch_ready: false;
    in-out property <string> key_panel_query: "";
    in-out property <string> key_panel_count_text: "";
    in-out property <[string]> key_panel_lines: [];

    callback refresh_requested();
    callback select_job(int);
    callback trigger_requested(string);
    callback delete_requested();
    callback confirm_delete();
    callback cancel_delete();
    callback query_changed(string);
    callback command_query_changed(string);
    callback command_requested();
    callback scope_filter_requested(string);
    callback status_filter_requested(string);
    callback cycle_disabled_filter_requested();
    callback cycle_run_at_load_filter_requested();
    callback cycle_keep_alive_filter_requested();
    callback cycle_error_filter_requested();
    callback clear_filters_requested();
    callback toggle_star_requested();
    callback copy_detail_requested();
    callback toggle_advanced_requested();
    callback star_filter_toggled(bool);
    callback editor_label_changed(string);
    callback editor_program_changed(string);
    callback editor_args_changed(string);
    callback editor_working_dir_changed(string);
    callback editor_start_interval_changed(string);
    callback editor_env_changed(string);
    callback editor_expert_entries_changed(string);
    callback toggle_log_mode_requested();
    callback log_window_minutes_changed(string);
    callback log_stream_seconds_changed(string);
    callback log_max_lines_changed(string);
    callback toggle_editor_run_at_load();
    callback toggle_editor_keep_alive();
    callback save_editor_requested();
    callback save_editor_and_load_requested();
    callback save_editor_load_enable_requested();
    callback new_job_requested(string);
    callback refresh_logs_requested();
    callback ai_prompt_changed(string);
    callback ai_request_requested();
    callback ai_cycle_provider_requested();
    callback ai_apply_patch_requested();
    callback ai_confirm_patch_requested();
    callback key_panel_query_changed(string);
    callback key_panel_add_requested(int);

    title: "LaunchPad";
    width: 1120px;
    height: 920px;
    background: RaycastTheme.background;

    VerticalBox {
        spacing: 12px;
        padding: 14px;

        TopCommandBar {
            busy: root.busy;
            command_query <=> root.command_query;
            refresh_requested => { root.refresh_requested(); }
            command_query_changed(value) => { root.command_query_changed(value); }
            command_requested => { root.command_requested(); }
        }

        SearchScopeBar {
            busy: root.busy;
            query_text <=> root.query_text;
            show_starred_only: root.show_starred_only;
            active_filter_text: root.active_filter_text;
            query_changed(value) => { root.query_changed(value); }
            star_filter_toggled(enabled) => { root.star_filter_toggled(enabled); }
            clear_filters_requested => { root.clear_filters_requested(); }
            scope_filter_requested(scope) => { root.scope_filter_requested(scope); }
        }

        StatusFilterBar {
            busy: root.busy;
            status_filter_text: root.status_filter_text;
            disabled_filter_text: root.disabled_filter_text;
            run_at_load_filter_text: root.run_at_load_filter_text;
            keep_alive_filter_text: root.keep_alive_filter_text;
            error_filter_text: root.error_filter_text;
            status_filter_requested(status) => { root.status_filter_requested(status); }
            cycle_disabled_filter_requested => { root.cycle_disabled_filter_requested(); }
            cycle_run_at_load_filter_requested => { root.cycle_run_at_load_filter_requested(); }
            cycle_keep_alive_filter_requested => { root.cycle_keep_alive_filter_requested(); }
            cycle_error_filter_requested => { root.cycle_error_filter_requested(); }
        }

        JobsWorkspace {
            busy: root.busy;
            job_lines: root.job_lines;
            selected_job_row: root.selected_job_row;
            detail_label: root.detail_label;
            detail_scope: root.detail_scope;
            detail_status: root.detail_status;
            detail_path: root.detail_path;
            detail_run_at_load: root.detail_run_at_load;
            detail_keep_alive: root.detail_keep_alive;
            detail_disabled_key: root.detail_disabled_key;
            detail_pid: root.detail_pid;
            detail_last_exit: root.detail_last_exit;
            detail_last_run: root.detail_last_run;
            detail_runtime_hint: root.detail_runtime_hint;
            detail_error: root.detail_error;
            is_starred: root.is_starred;
            advanced_detail_visible: root.advanced_detail_visible;
            select_job(index) => { root.select_job(index); }
            toggle_star_requested => { root.toggle_star_requested(); }
            copy_detail_requested => { root.copy_detail_requested(); }
            toggle_advanced_requested => { root.toggle_advanced_requested(); }
        }

        ActionBar {
            busy: root.busy;
            can_trigger: root.can_trigger;
            can_delete: root.can_delete;
            trigger_requested(action) => { root.trigger_requested(action); }
            delete_requested => { root.delete_requested(); }
        }

        Rectangle {
            border-width: 1px;
            border-color: RaycastTheme.border;
            border-radius: 10px;
            background: RaycastTheme.surface;
            clip: true;

            VerticalBox {
                padding: 10px;
                spacing: 8px;

                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: "Plist Editor (Standard + XML)";
                        font-weight: 700;
                        color: RaycastTheme.text-primary;
                    }
                    Text {
                        text: root.editor_target_text;
                        color: RaycastTheme.text-secondary;
                    }
                    Button {
                        text: "New User Job";
                        enabled: !root.busy;
                        clicked => { root.new_job_requested("user-agent"); }
                    }
                    Button {
                        text: "New Global Job";
                        enabled: !root.busy;
                        clicked => { root.new_job_requested("global-agent"); }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    LineEdit {
                        width: 220px;
                        enabled: !root.busy;
                        text <=> root.editor_label;
                        placeholder-text: "Label";
                        edited(value) => { root.editor_label_changed(value); }
                    }
                    LineEdit {
                        width: 220px;
                        enabled: !root.busy;
                        text <=> root.editor_program;
                        placeholder-text: "Program path";
                        edited(value) => { root.editor_program_changed(value); }
                    }
                    LineEdit {
                        width: 240px;
                        enabled: !root.busy;
                        text <=> root.editor_program_arguments;
                        placeholder-text: "ProgramArguments (space separated)";
                        edited(value) => { root.editor_args_changed(value); }
                    }
                    LineEdit {
                        width: 200px;
                        enabled: !root.busy;
                        text <=> root.editor_working_directory;
                        placeholder-text: "WorkingDirectory";
                        edited(value) => { root.editor_working_dir_changed(value); }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    LineEdit {
                        width: 220px;
                        enabled: !root.busy;
                        text <=> root.editor_start_interval;
                        placeholder-text: "StartInterval (seconds)";
                        edited(value) => { root.editor_start_interval_changed(value); }
                    }
                    LineEdit {
                        width: 460px;
                        enabled: !root.busy;
                        text <=> root.editor_env_vars;
                        placeholder-text: "EnvironmentVariables: KEY=VALUE, KEY2=VALUE2";
                        edited(value) => { root.editor_env_changed(value); }
                    }
                    Button {
                        text: root.editor_run_at_load ? "RunAtLoad:yes" : "RunAtLoad:no";
                        enabled: !root.busy;
                        clicked => { root.toggle_editor_run_at_load(); }
                    }
                    Button {
                        text: root.editor_keep_alive ? "KeepAlive:yes" : "KeepAlive:no";
                        enabled: !root.busy;
                        clicked => { root.toggle_editor_keep_alive(); }
                    }
                    Button {
                        text: "Save";
                        enabled: !root.busy;
                        clicked => { root.save_editor_requested(); }
                    }
                    Button {
                        text: "Save+Load";
                        enabled: !root.busy;
                        clicked => { root.save_editor_and_load_requested(); }
                    }
                    Button {
                        text: "Save+Load+Enable";
                        enabled: !root.busy;
                        clicked => { root.save_editor_load_enable_requested(); }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    LineEdit {
                        width: 980px;
                        enabled: !root.busy;
                        text <=> root.editor_expert_entries;
                        placeholder-text: "Expert keys: KEY=VALUE, KEY2=VALUE2 (for undocumented or advanced launchd keys)";
                        edited(value) => { root.editor_expert_entries_changed(value); }
                    }
                }

                Rectangle {
                    border-width: 1px;
                    border-color: RaycastTheme.border;
                    border-radius: 8px;
                    background: RaycastTheme.surface-muted;
                    VerticalBox {
                        padding: 8px;
                        Text {
                            text: root.editor_xml_preview;
                            wrap: word-wrap;
                            color: RaycastTheme.text-secondary;
                        }
                    }
                }

                Rectangle {
                    border-width: 1px;
                    border-color: RaycastTheme.border-warning;
                    border-radius: 8px;
                    background: RaycastTheme.warning-bg;
                    VerticalBox {
                        padding: 8px;
                        Text {
                            text: "Diagnostics";
                            color: RaycastTheme.warning-text;
                            font-weight: 600;
                        }
                        Text {
                            text: root.editor_diagnostics_text;
                            wrap: word-wrap;
                            color: RaycastTheme.warning-text;
                        }
                    }
                }

                Rectangle {
                    border-width: 1px;
                    border-color: RaycastTheme.border;
                    border-radius: 8px;
                    background: RaycastTheme.surface-muted;
                    VerticalBox {
                        padding: 8px;
                        spacing: 6px;
                        HorizontalBox {
                            spacing: 8px;
                            Text {
                                text: "Logs";
                                color: RaycastTheme.text-primary;
                                font-weight: 600;
                            }
                            Button {
                                text: root.log_mode_text;
                                enabled: !root.busy;
                                clicked => { root.toggle_log_mode_requested(); }
                            }
                            LineEdit {
                                width: 130px;
                                enabled: !root.busy;
                                text <=> root.log_window_minutes;
                                placeholder-text: "Window (min)";
                                edited(value) => { root.log_window_minutes_changed(value); }
                            }
                            LineEdit {
                                width: 130px;
                                enabled: !root.busy;
                                text <=> root.log_stream_seconds;
                                placeholder-text: "Stream (sec)";
                                edited(value) => { root.log_stream_seconds_changed(value); }
                            }
                            LineEdit {
                                width: 130px;
                                enabled: !root.busy;
                                text <=> root.log_max_lines;
                                placeholder-text: "Max lines";
                                edited(value) => { root.log_max_lines_changed(value); }
                            }
                            Button {
                                text: "Refresh Logs";
                                enabled: !root.busy;
                                clicked => { root.refresh_logs_requested(); }
                            }
                        }
                        Text {
                            text: root.log_view_text;
                            wrap: word-wrap;
                            color: RaycastTheme.text-secondary;
                        }
                    }
                }

                Rectangle {
                    border-width: 1px;
                    border-color: RaycastTheme.border-info;
                    border-radius: 8px;
                    background: RaycastTheme.surface-info;
                    VerticalBox {
                        padding: 8px;
                        spacing: 6px;
                        HorizontalBox {
                            spacing: 8px;
                            LineEdit {
                                width: 720px;
                                enabled: !root.busy;
                                text <=> root.ai_prompt;
                                placeholder-text: "Ask AI to modify this launchd job...";
                                edited(value) => { root.ai_prompt_changed(value); }
                                accepted => { root.ai_request_requested(); }
                            }
                            Button {
                                text: root.ai_provider_text;
                                enabled: !root.busy;
                                clicked => { root.ai_cycle_provider_requested(); }
                            }
                            Button {
                                text: "AI Analyze";
                                enabled: !root.busy;
                                clicked => { root.ai_request_requested(); }
                            }
                            Button {
                                text: "Apply AI Patch";
                                enabled: root.ai_patch_ready && !root.busy;
                                clicked => { root.ai_apply_patch_requested(); }
                            }
                            Button {
                                text: "Confirm Apply";
                                enabled: root.ai_patch_ready && !root.busy;
                                clicked => { root.ai_confirm_patch_requested(); }
                            }
                        }
                        Text {
                            text: root.ai_response;
                            wrap: word-wrap;
                            color: RaycastTheme.accent;
                        }
                        Text {
                            text: root.ai_diff_preview;
                            wrap: word-wrap;
                            color: RaycastTheme.text-secondary;
                        }
                    }
                }

                Rectangle {
                    border-width: 1px;
                    border-color: RaycastTheme.border;
                    border-radius: 8px;
                    background: RaycastTheme.surface;
                    VerticalBox {
                        padding: 8px;
                        spacing: 6px;
                        HorizontalBox {
                            spacing: 8px;
                            LineEdit {
                                width: 320px;
                                enabled: !root.busy;
                                text <=> root.key_panel_query;
                                placeholder-text: "Search launchd keys...";
                                edited(value) => { root.key_panel_query_changed(value); }
                            }
                            Text {
                                text: "Key Panel · " + root.key_panel_count_text;
                                vertical-alignment: center;
                                color: RaycastTheme.text-secondary;
                            }
                        }
                        Rectangle {
                            border-width: 1px;
                            border-color: RaycastTheme.border;
                            border-radius: 8px;
                            background: RaycastTheme.surface-muted;
                            clip: true;
                            height: 170px;
                            ListView {
                                for line[index] in root.key_panel_lines : Rectangle {
                                    height: 34px;
                                    background: RaycastTheme.surface;
                                    Text {
                                        text: line;
                                        x: 8px;
                                        y: (parent.height - self.height) / 2;
                                        color: RaycastTheme.text-secondary;
                                    }
                                    TouchArea {
                                        clicked => { root.key_panel_add_requested(index); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            visible: root.confirm_delete_visible;
            border-width: 1px;
            border-color: RaycastTheme.border-danger;
            border-radius: 8px;
            background: RaycastTheme.danger-bg;
            opacity: root.confirm_delete_visible ? 1 : 0;
            animate opacity { duration: 140ms; easing: ease-in-out; }

            VerticalBox {
                padding: 10px;
                spacing: 6px;
                Text {
                    text: "Delete '" + root.confirm_delete_label + "' ?";
                    color: RaycastTheme.danger-text;
                    font-weight: 600;
                }
                Text {
                    text: "This action is irreversible. The plist file will be removed.";
                    wrap: word-wrap;
                }
                HorizontalBox {
                    spacing: 8px;
                    Button {
                        text: "Confirm Delete";
                        enabled: !root.busy;
                        clicked => { root.confirm_delete(); }
                    }
                    Button {
                        text: "Cancel";
                        enabled: !root.busy;
                        clicked => { root.cancel_delete(); }
                    }
                }
            }
        }

        Rectangle {
            border-width: 1px;
            border-color: RaycastTheme.border;
            border-radius: 8px;
            background: RaycastTheme.surface;
            VerticalBox {
                padding: 8px;
                Text {
                    text: root.busy ? "Working..." : root.status_message;
                    wrap: word-wrap;
                    color: root.busy ? RaycastTheme.accent : RaycastTheme.text-secondary;
                }
            }
        }
    }
}
