export global RaycastTheme {
    in property <color> background: #f4f6fb;
    in property <color> surface: #ffffff;
    in property <color> surface-muted: #f8f9fc;
    in property <color> border: #d0d5dd;
    in property <color> text-primary: #101828;
    in property <color> text-secondary: #475467;
    in property <color> accent: #175cd3;
    in property <color> warning-bg: #fffaeb;
    in property <color> warning-text: #7a2e0e;
}
